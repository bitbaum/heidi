# Secrets and settings this app reads at runtime. Copy to .env and fill in.
# Values live on the Hetzner box (/home/g/dev/<app>/.env), never in git.
DATABASE_URL=
SPEECH_API_URL=
SPEECH_API_KEY=
SPEECH_DIALECT=
LANGUAGETOOL_URL=
NEXT_PUBLIC_FC_WIDGET_TOKEN=
# Channels (lib/channels). The hourly sweep (/api/cron/channels) runs only with
# CRON_SECRET; without it the channels page refreshes a person's own channels
# inline. Web Push needs a VAPID pair: `npx web-push generate-vapid-keys`.
# VAPID_SUBJECT is a mailto: or https: URL the push services may contact.
CRON_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# The fleet's chat-review loop. One shared secret, the same value in every
# product's env on the box (Loki's share-chat-review-token.yml writes it);
# Loki reads GET /api/chat/review-export with it each night. Unset, the
# export answers 503 and nothing is read.
CHAT_REVIEW_TOKEN=
