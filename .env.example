# Secrets and settings this app reads at runtime. Copy to .env and fill in.
# Values live on the Hetzner box (/home/g/dev/<app>/.env), never in git.
DATABASE_URL=
SPEECH_API_URL=
SPEECH_API_KEY=
SPEECH_DIALECT=
LANGUAGETOOL_URL=
NEXT_PUBLIC_FC_WIDGET_TOKEN=
# Channels (lib/channels). The hourly sweep (/api/cron/channels) runs only with
# CRON_SECRET; without it the channels page refreshes a person's own channels
# inline. Web Push needs a VAPID pair: `npx web-push generate-vapid-keys`.
# VAPID_SUBJECT is a mailto: or https: URL the push services may contact.
CRON_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# The fleet's chat-review loop. One shared secret, the same value in every
# product's env on the box (Loki's share-chat-review-token.yml writes it);
# Loki reads GET /api/chat/review-export with it each night. Unset, the
# export answers 503 and nothing is read.
CHAT_REVIEW_TOKEN=
# Accounts (@bitbaum/accountkit). BETTER_AUTH_SECRET signs sessions; without it
# (or without DATABASE_URL) the sign-in control is hidden. Generate once with
# `openssl rand -base64 48`.
BETTER_AUTH_SECRET=
# Account mail through @bitbaum/mail-kit: "Forgot your password?", the email
# sign-in link and the address check. Unset (or a placeholder key), the sign-in
# page offers none of them. RESEND_API_KEY is the fleet's shared Resend key.
# RESEND_FROM is optional: unset, mail goes out as
# `Heidi <heidi@fleetcrown.orangecat.ch>`, the fleet's one verified sender
# domain. A resend.dev sandbox sender counts as unconfigured in production.
RESEND_API_KEY=
RESEND_FROM=
